# ================================================================
# Variables d'environnement — COPIER vers .env et remplir
# NE JAMAIS committer le fichier .env
# ================================================================

# AWS Credentials (ou utiliser IAM Role en production)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-west-1

# LocalStack (pour simulation locale sans compte AWS)
# Décommenter pour utiliser LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Application
DATABASE_URL=postgresql://appuser:CHANGE_ME@localhost:5432/cdnu_db
S3_BUCKET_PREFIX=cdnu-storage
APP_SECRET_KEY=CHANGE_ME_32_chars_minimum

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_RETENTION_DAYS=15
